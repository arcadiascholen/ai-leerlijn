---
import Base from '../layouts/Base.astro';
---

<Base>
  <h1>AI-leerpad</h1>
  <p class="lead">
    Op dinsdag 10 november doorloop je hier een module over artificiële
    intelligentie. Je kiest zelf welke.
  </p>
  <p class="status">Deze site is nog in opbouw.</p>
</Base>

<style>
  .lead {
    font-size: var(--step-1);
    max-width: 40rem;
  }

  .status {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface-tint);
    color: var(--color-text-muted);
  }
</style>
