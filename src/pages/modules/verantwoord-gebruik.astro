---
import Base from '../../layouts/Base.astro';
import LoepPlayer from '../../components/loep/LoepPlayer';
import {checkLink,eindformulier} from '../../config/smartschool';
const formHref=checkLink('eindformulier',eindformulier);
---
<Base title="AI onder de loep" description="Onderzoek AI en zijn gevolgen in vier interactieve uitdagingen. Bouw je eigen AI-kompas." fill>
  <LoepPlayer client:load formHref={formHref}/>
  <noscript><p>Voor de interactieve opdrachten heb je JavaScript nodig. Zet het aan in je browser en herlaad de pagina.</p></noscript>
</Base>
