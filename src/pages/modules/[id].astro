---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AiGebruik from '../../components/modules/AiGebruik.astro';
import Keuze from '../../components/stappen/Keuze.astro';
import Stap from '../../components/stappen/Stap.astro';
import Samenvatting from '../../components/stappen/Samenvatting.astro';
import { checkModuleBody, type BranchingChoice } from '../../components/stappen/checks';
import StepPlayer from '../../components/stappen/StepPlayer.astro';
import DenkEerst from '../../components/vragen/DenkEerst.astro';
import Meerkeuze from '../../components/vragen/Meerkeuze.astro';
import Optie from '../../components/vragen/Optie.astro';
import Reflectie from '../../components/vragen/Reflectie.astro';

// One page per module that is ready. Modules with `status: binnenkort` are
// shown in the overview but get no page (BRIEFING § 5).
export async function getStaticPaths() {
  const entries = await getCollection('modules', ({ data }) => data.status === 'beschikbaar');
  return entries.map((entry) => {
    const { branching } = checkModuleBody(entry.id, entry.body ?? '');
    return { params: { id: entry.id }, props: { entry, branching } };
  });
}

interface Props {
  entry: CollectionEntry<'modules'>;
  branching: BranchingChoice | null;
}

const { entry, branching } = Astro.props;
const { Content } = await render(entry);

// Components inside the MDX get no props from here, but share Astro.locals
// with this page. <Samenvatting /> shows the module's name; <Stap> and
// <Keuze> need the branching choice as read from the source.
const locals = Astro.locals as { moduleTitle?: string; branching?: BranchingChoice | null };
locals.moduleTitle = entry.data.title;
locals.branching = branching;

// Components that authors may use in a module's MDX without an import line
// (BRIEFING § 12). Question components are added here.
const components = { Stap, Keuze, Meerkeuze, Optie, DenkEerst, Reflectie, Samenvatting };
---

<Base title={entry.data.title} description={entry.data.kort} fill>
  <StepPlayer moduleId={entry.id} title={entry.data.title}>
    {/* Whether the student uses AI, in one sentence at the top of the module
        (BRIEFING § 7). */}
    <AiGebruik slot="meta" value={entry.data.aiGebruik} />
    <Content components={components} />
  </StepPlayer>
</Base>
