---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AiGebruik from '../../components/modules/AiGebruik.astro';
import AI from '../../components/inhoud/AI.astro';
import Bericht from '../../components/inhoud/Bericht.astro';
import Chat from '../../components/inhoud/Chat.astro';
import Hulp from '../../components/inhoud/Hulp.astro';
import Jij from '../../components/inhoud/Jij.astro';
import Keuzechat from '../../components/inhoud/Keuzechat.astro';
import Prompt from '../../components/inhoud/Prompt.astro';
import Ronde from '../../components/inhoud/Ronde.astro';
import ChosenTool from '../../components/stappen/ChosenTool.astro';
import Confetti from '../../components/stappen/Confetti.astro';
import Keuze from '../../components/stappen/Keuze.astro';
import Stap from '../../components/stappen/Stap.astro';
import Samenvatting from '../../components/stappen/Samenvatting.astro';
import SchoolLink from '../../components/stappen/SchoolLink.astro';
import { checkModuleBody, type ModuleOutline, type SourceChoice } from '../../components/stappen/checks';
import StepPlayer from '../../components/stappen/StepPlayer.astro';
import Tool from '../../components/stappen/Tool.astro';
import DenkEerst from '../../components/vragen/DenkEerst.astro';
import Flashcards from '../../components/vragen/Flashcards.astro';
import Meerkeuze from '../../components/vragen/Meerkeuze.astro';
import Meting from '../../components/vragen/Meting.astro';
import Optie from '../../components/vragen/Optie.astro';
import Reflectie from '../../components/vragen/Reflectie.astro';
import Vibe from '../../components/vibecoding/Vibe.astro';

// One page per module that is ready. Modules with `status: binnenkort` are
// shown in the overview but get no page. A module with `status: verborgen` only
// has a page in `npm run dev`, for testing (BRIEFING § 5).
export async function getStaticPaths() {
  const entries = await getCollection(
    'modules',
    ({ data }) => data.status === 'beschikbaar' || (import.meta.env.DEV && data.status === 'verborgen'),
  );
  // The dedicated route supports two choices from six.
  return entries.filter(entry => entry.id !== 'verantwoord-gebruik').map((entry) => {
    const outline = checkModuleBody(entry.id, entry.body ?? '');
    return { params: { id: entry.id }, props: { entry, ...outline } };
  });
}

interface Props extends ModuleOutline {
  entry: CollectionEntry<'modules'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// In dev, <Content> follows a saved module file at once, but the content
// store behind `entry.body`, and with it the props above, catches up about
// half a second later. A page rendered in between would hand the new
// components the old outline, and they fail on it. So dev reads the outline
// from the file itself; the build has one source and keeps the props.
let outline: ModuleOutline = Astro.props;
if (import.meta.env.DEV) {
  const sources = import.meta.glob<string>('/src/content/modules/**/*.mdx', { query: '?raw', import: 'default' });
  const load = sources[`/${entry.filePath ?? ''}`];
  if (load !== undefined) {
    // The body as the MDX loader reads it: without frontmatter, trimmed.
    const body = (await load()).replace(/^(?:\uFEFF|\s*\n)?---[\s\S]*?\n---/, '').trim();
    outline = checkModuleBody(entry.id, body);
  }
}
const { branching, tool, promptSteps, sourceSteps, choiceChatSteps, flashcardDecks } = outline;

// Components inside the MDX get no props from here, but share Astro.locals
// with this page. <Samenvatting /> shows the module's name; <Stap> and
// <Keuze> need the branching choice as read from the source, <Tool> and
// <Keuze> the tool choice, a <Prompt> with `velden` and a <Keuzechat> the title
// of their step, a <Prompt> with `overnemen` the titles of the steps of its
// sources, and <Flashcards> its example deck.
const locals = Astro.locals as {
  moduleTitle?: string;
  branching?: SourceChoice | null;
  tool?: SourceChoice | null;
  promptSteps?: Readonly<Record<string, string>>;
  sourceSteps?: Readonly<Record<string, string>>;
  choiceChatSteps?: Readonly<Record<string, string>>;
  flashcardDecks?: Readonly<Record<string, string>>;
};
locals.moduleTitle = entry.data.title;
locals.branching = branching;
locals.tool = tool;
locals.promptSteps = promptSteps;
locals.sourceSteps = sourceSteps;
locals.choiceChatSteps = choiceChatSteps;
locals.flashcardDecks = flashcardDecks;

// The page about which AI tools are allowed, linked next to the sentence about
// AI use when the student uses AI (BRIEFING § 7).
const toolsHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/tools/`;

// Components that authors may use in a module's MDX without an import line
// (BRIEFING § 12). Question and content components are added here.
const components = {
  Stap,
  Keuze,
  Tool,
  Prompt,
  Chat,
  Jij,
  AI,
  Keuzechat,
  Ronde,
  Bericht,
  Hulp,
  Meerkeuze,
  Optie,
  DenkEerst,
  Reflectie,
  Meting,
  Flashcards,
  Samenvatting,
  SchoolLink,
  Vibe,
  Confetti,
};
---

<Base title={entry.data.title} description={entry.data.kort} fill>
  {/* The chosen tool, before the first paint (BRIEFING § 12, "Instructies
      per tool"). */}
  <ChosenTool slot="head" moduleId={entry.id} choice={tool} />
  <StepPlayer moduleId={entry.id} title={entry.data.title}>
    {/* Whether the student uses AI, in one sentence at the top of the module
        (BRIEFING § 7). */}
    <AiGebruik slot="meta" value={entry.data.aiGebruik} toolsHref={toolsHref} />
    <Content components={components} />
  </StepPlayer>
</Base>
