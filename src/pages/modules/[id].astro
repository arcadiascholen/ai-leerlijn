---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AiGebruik from '../../components/modules/AiGebruik.astro';
import AI from '../../components/inhoud/AI.astro';
import Chat from '../../components/inhoud/Chat.astro';
import Jij from '../../components/inhoud/Jij.astro';
import Prompt from '../../components/inhoud/Prompt.astro';
import ChosenTool from '../../components/stappen/ChosenTool.astro';
import Keuze from '../../components/stappen/Keuze.astro';
import Stap from '../../components/stappen/Stap.astro';
import Samenvatting from '../../components/stappen/Samenvatting.astro';
import { checkModuleBody, type SourceChoice } from '../../components/stappen/checks';
import StepPlayer from '../../components/stappen/StepPlayer.astro';
import Tool from '../../components/stappen/Tool.astro';
import DenkEerst from '../../components/vragen/DenkEerst.astro';
import Meerkeuze from '../../components/vragen/Meerkeuze.astro';
import Optie from '../../components/vragen/Optie.astro';
import Reflectie from '../../components/vragen/Reflectie.astro';

// One page per module that is ready. Modules with `status: binnenkort` are
// shown in the overview but get no page (BRIEFING § 5).
export async function getStaticPaths() {
  const entries = await getCollection('modules', ({ data }) => data.status === 'beschikbaar');
  return entries.map((entry) => {
    const { branching, tool } = checkModuleBody(entry.id, entry.body ?? '');
    return { params: { id: entry.id }, props: { entry, branching, tool } };
  });
}

interface Props {
  entry: CollectionEntry<'modules'>;
  branching: SourceChoice | null;
  tool: SourceChoice | null;
}

const { entry, branching, tool } = Astro.props;
const { Content } = await render(entry);

// Components inside the MDX get no props from here, but share Astro.locals
// with this page. <Samenvatting /> shows the module's name; <Stap> and
// <Keuze> need the branching choice as read from the source, <Tool> and
// <Keuze> the tool choice.
const locals = Astro.locals as {
  moduleTitle?: string;
  branching?: SourceChoice | null;
  tool?: SourceChoice | null;
};
locals.moduleTitle = entry.data.title;
locals.branching = branching;
locals.tool = tool;

// The page about which AI tools are allowed, linked next to the sentence about
// AI use when the student uses AI (BRIEFING § 7).
const toolsHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/tools/`;

// Components that authors may use in a module's MDX without an import line
// (BRIEFING § 12). Question and content components are added here.
const components = {
  Stap,
  Keuze,
  Tool,
  Prompt,
  Chat,
  Jij,
  AI,
  Meerkeuze,
  Optie,
  DenkEerst,
  Reflectie,
  Samenvatting,
};
---

<Base title={entry.data.title} description={entry.data.kort} fill>
  {/* The chosen tool, before the first paint (BRIEFING § 12, "Instructies
      per tool"). */}
  <ChosenTool slot="head" moduleId={entry.id} choice={tool} />
  <StepPlayer moduleId={entry.id} title={entry.data.title}>
    {/* Whether the student uses AI, in one sentence at the top of the module
        (BRIEFING § 7). */}
    <AiGebruik slot="meta" value={entry.data.aiGebruik} toolsHref={toolsHref} />
    <Content components={components} />
  </StepPlayer>
</Base>
