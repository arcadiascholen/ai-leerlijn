---
import '@fontsource-variable/figtree';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import logo from '../assets/logo/arcadia-logo.svg';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'AI-leerpad · Arcadia Scholen';
const { title, description = 'Een digitaal leerpad over artificiële intelligentie voor de leerlingen van Arcadia Scholen.' } = Astro.props;
const fullTitle = title ? `${title} · ${siteName}` : siteName;

// Logo in the header bar: 24–30px high (docs/DESIGN.md).
const logoHeight = 28;
const logoWidth = Math.round((logo.width * logoHeight) / logo.height);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={import.meta.env.BASE_URL}>
          <img src={logo.src} width={logoWidth} height={logoHeight} alt="Arcadia scholen" />
          <span class="brand-site">AI-leerpad</span>
        </a>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    min-height: var(--shell-bar);
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--forest);
    text-decoration: none;
  }

  .brand img {
    display: block;
  }

  .brand-site {
    padding-left: var(--space-3);
    border-left: 1px solid var(--line);
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line);
    font-weight: var(--text-h3-weight);
    letter-spacing: var(--text-h3-tracking);
  }

  .site-main {
    flex: 1;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-5);
  }
</style>
