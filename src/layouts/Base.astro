---
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'AI-leerpad · Arcadia Scholen';
const { title, description = 'Een digitaal leerpad over artificiële intelligentie voor de leerlingen van Arcadia Scholen.' } = Astro.props;
const fullTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL}>
        <span class="brand-org">Arcadia Scholen</span>
        <span class="brand-sep" aria-hidden="true">·</span>
        <span class="brand-site">AI-leerpad</span>
      </a>
    </header>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    height: var(--header-height);
    display: flex;
    align-items: center;
    padding: 0 var(--space-md);
    background: var(--color-brand);
    color: var(--color-on-brand);
  }

  .brand {
    display: flex;
    gap: var(--space-xs);
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    font-size: var(--step-1);
  }

  .brand-org {
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .brand-sep,
  .brand-site {
    font-weight: 400;
  }

  .site-main {
    flex: 1;
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
</style>
