---
// What the student takes along from a module (docs/BRIEFING.md § 12, "Vraagtypes"):
//
//   <Meeneemkaart id="mijn-kaart" vraag="Mijn kaart: als ik vastloop">
//     <Rij situatie="Ik zit vast">Geef me één hint, niet de oplossing.</Rij>
//     <Rij situatie="Ik kom fout uit">Dit is mijn oplossing: […] Waar gaat het fout?</Rij>
//   </Meeneemkaart>
//
// `id` is the stable key of the answer in localStorage, unique within the module.
// Every row is a text field, filled in beforehand with the author's sentence, for
// the student to make their own. The rows are read back into data here and handed
// to the React island as props, with the client directive, so authors write
// neither.
//
// The script below does the storing, not the island:
//
// - The card stores itself, with the author's sentences, when its step is shown,
//   so it counts for whoever saw it. Until the player's script has run, every step
//   is on screen, so this only starts looking after DOMContentLoaded, as the
//   confetti does: `client:visible` alone would store the card at load. A step off
//   the student's route is never shown, so its card stores nothing.
// - Every keystroke stores its row. React puts the server's text back into a
//   prefilled field when it hydrates, so what is typed before that survives only
//   here; the island then restores it. Only the row typed in is written: before
//   hydration the other fields still show the author's sentences, not the stored
//   ones. In the capture phase, so that the summary, listening on the document,
//   reads what was just typed if an author puts it on the same step.
import MeeneemkaartIsland from './Meeneemkaart.tsx';
import { checkQuestionId, checkText, decodeRows } from './authoring';

interface Props {
  id: string;
  vraag: string;
}

const id = checkQuestionId('Meeneemkaart', Astro.props.id, Astro.locals);
const vraag = checkText('Meeneemkaart', 'vraag', Astro.props.vraag);
const rows = decodeRows(id, Astro.slots.has('default') ? await Astro.slots.render('default') : '');
---

<MeeneemkaartIsland id={id} question={vraag} rows={rows} client:visible />

<script>
  import { moduleIdOf } from '../stappen/storage';
  import { authorRowsOf, readTakeawayRows, writeTakeawayRows } from './answers';

  function storeWhenShown(root: HTMLElement): void {
    const moduleId = moduleIdOf(root);
    const step = root.closest('[data-step]');
    if (moduleId === null || step === null) return;
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      if (readTakeawayRows(moduleId, root) === null) writeTakeawayRows(moduleId, root, authorRowsOf(root));
    });
    observer.observe(step);
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('[data-question="takeaway-card"]').forEach(storeWhenShown);
  });

  document.addEventListener(
    'input',
    (event) => {
      const field = event.target;
      if (!(field instanceof HTMLTextAreaElement) || field.dataset.takeawayRow === undefined) return;
      const root = field.closest<HTMLElement>('[data-question="takeaway-card"]');
      const moduleId = root === null ? null : moduleIdOf(root);
      if (root === null || moduleId === null) return;
      const rows = readTakeawayRows(moduleId, root) ?? authorRowsOf(root);
      const row = rows[Number(field.dataset.takeawayRow)];
      if (row === undefined) return;
      row.text = field.value;
      writeTakeawayRows(moduleId, root, rows);
    },
    true,
  );
</script>
