---
// What the student has learned so far (docs/BRIEFING.md § 12, "Vraagtypes"):
//
//   <Stap titel="Je nieuwe skills">
//   <Meeneemkaart>
//     <Rij situatie="Context helpt">Geef AI je cursus, desnoods als afbeelding.</Rij>
//     <Rij situatie="Uitleg vragen">Leg het eerst zelf uit, en laat AI je uitleg bijsturen.</Rij>
//   </Meeneemkaart>
//   </Stap>
//
// Something to read, not to fill in: no island and no script, nothing stored, not
// in the summary. So it has no `id` and may appear as often as a module needs it;
// the author writes per step the rows that are on the card at that moment. The
// heading is the title of the step. The root is the <dl>, so that the card is one
// part of the build-up of the step. Authors write no import.
import { decodeRows } from './authoring';

const rows = decodeRows(Astro.slots.has('default') ? await Astro.slots.render('default') : '');
---

<dl class="card">
  {
    rows.map(({ situation, html }) => (
      <div class="row">
        <dt class="situation">{situation}</dt>
        <dd class="sentence" set:html={html} />
      </div>
    ))
  }
</dl>

<style>
  /* Only design-system tokens (docs/DESIGN.md), no barometer colours. Green is the
     student: the situations are `brand-text`. Height budget on 1366 × 640: see
     docs/BRIEFING.md § 12, "Vraagtypes". A row of one line is 30px, of two lines
     52px, with 4px between the rows. */
  .card {
    display: grid;
    gap: var(--space-1);
    max-width: 52rem;
    margin: 0;
  }

  /* Space below the card only when the author wrote more after it. */
  .card:not(:last-child) {
    margin-bottom: var(--space-4);
  }

  .row {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: start;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
  }

  .situation,
  .sentence {
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    letter-spacing: var(--text-small-tracking);
  }

  .situation {
    color: var(--brand-text);
    font-weight: var(--text-label-weight);
  }

  .sentence {
    margin: 0;
    font-weight: var(--text-small-weight);
  }

  /* The last row is the new one: a sunken surface, nothing that moves or shouts. */
  .row:last-child {
    background: var(--surface-sunken);
  }
</style>
