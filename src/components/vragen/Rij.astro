---
// One row of a <Meeneemkaart> (docs/BRIEFING.md § 12, "Vraagtypes"):
//
//   <Rij situatie="Context helpt">Geef AI je cursus, desnoods als afbeelding.</Rij>
//
// `situatie` is the label of the row; the text between the tags is its sentence,
// in which inline Markdown such as **bold** is allowed.
//
// <Meeneemkaart> renders its children to HTML and reads the rows back from the
// JSON below; nothing of this reaches the page itself. A <Rij> outside a
// <Meeneemkaart> fails the build (checks.ts).
import { checkText, encodeRow, readRowHtml } from './authoring';

interface Props {
  situatie: string;
}

const situation = checkText('Rij', 'situatie', Astro.props.situatie);
const html = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const data = encodeRow({ situation, html: readRowHtml(situation, html) });
---

<script type="application/json" data-rij is:inline set:html={data} />
