---
// The summary at the end of a module (docs/BRIEFING.md § 6 and § 12):
//
//   <Stap titel="Klaar! Download je samenvatting">
//   <Samenvatting />
//   </Stap>
//
// It counts what the student wrote in <DenkEerst>, <Reflectie> and the
// fields of a <Prompt>, and chose in a <Meting>, how a deck of <Flashcards> went, lists what is still empty, and makes a PDF of every
// question with its answer, and a timeline, for the final form in
// Smartschool. It belongs in the last step, once per module;
// the module route checks that when it builds. Authors write no import, no
// props and no client directive.
//
// The button to the final form is a <SchoolLink>, rendered here and passed to
// the island as children: the form exists once per school (BRIEFING § 12,
// "Een link per school"). Without children the island says the link follows.
import SamenvattingIsland from './Samenvatting.tsx';
import SchoolLink from './SchoolLink.astro';
import { eindformulier } from '../../config/smartschool';

// Set by src/pages/modules/[id].astro: components inside a module's MDX get
// no props from the route, but share Astro.locals with it.
const moduleTitle = (Astro.locals as { moduleTitle?: string }).moduleTitle;
if (moduleTitle === undefined) {
  throw new Error('<Samenvatting /> only works inside a module (src/content/modules/).');
}
if (Astro.slots.has('default')) {
  throw new Error('<Samenvatting /> takes no content between its tags: write <Samenvatting />.');
}
---

{
  eindformulier !== null ? (
    <SamenvattingIsland moduleTitle={moduleTitle} client:visible>
      <SchoolLink href={eindformulier}>Open het eindformulier</SchoolLink>
    </SamenvattingIsland>
  ) : (
    <SamenvattingIsland moduleTitle={moduleTitle} client:visible />
  )
}
