---
// One step of a module: one idea or one question per screen
// (docs/BRIEFING.md § 6 and § 12). Authors write <Stap titel="…"> in the
// module's MDX without an import; the module route passes this component to
// <Content components={…}>. StepPlayer numbers the steps and shows one at a
// time; without JavaScript every step is a card, one below the other.
//
// `tak="toets"` makes the step part of the branch "toets" of the module's
// branching <Keuze> (BRIEFING § 12, "Keuzes en takken"); a step without
// `tak` is shared. The player shows a branch step only to a student who
// chose that option. Without JavaScript every step is there, and a branch
// step says for whom it is.
import type { SourceChoice } from './checks';

interface Props {
  titel: string;
  tak?: string;
}

const { titel, tak } = Astro.props;

// MDX props are not type-checked, so a missing title would otherwise only
// show up as an empty heading.
if (typeof titel !== 'string' || titel.trim() === '') {
  throw new Error('<Stap> needs a non-empty `titel` attribute.');
}

// The label of a branch step comes from the branching choice as the module
// route read it from the source: the <Keuze> itself renders in another step,
// and a step cannot rely on it having rendered first. The route's checks
// already guarantee that `tak` is one of its options; this is the fallback
// for a <Stap> used anywhere else.
let branchLabel: string | undefined;
if (tak !== undefined) {
  const branching = (Astro.locals as { branching?: SourceChoice | null }).branching;
  if (typeof tak === 'string' && branching != null && Object.hasOwn(branching.options, tak)) {
    branchLabel = branching.options[tak];
  }
  if (branchLabel === undefined) {
    throw new Error(`<Stap titel="${titel}" tak=${JSON.stringify(tak)}> is not an option of a <Keuze … vertakt>.`);
  }
}
---

<section class="step" data-step data-tak={tak}>
  {branchLabel !== undefined && <p class="step-branch">Voor: {branchLabel}</p>}
  <h2 class="step-title" data-step-title tabindex="-1">{titel}</h2>
  <slot />
</section>

<style>
  /* Without JavaScript: every step is its own card. */
  .step {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  /* With JavaScript: the player's card is the card. */
  :global(.js) .step {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }

  .step[hidden] {
    display: none;
  }

  .step > :global(:last-child) {
    margin-bottom: 0;
  }

  /* Without JavaScript: for whom a branch step is, above its title. With
     JavaScript the student only sees the steps of their own branch. */
  .step-branch {
    margin: 0 0 var(--space-2);
    color: var(--brand-text);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    font-weight: var(--text-label-weight);
    letter-spacing: var(--text-label-tracking);
    text-transform: uppercase;
  }

  :global(.js) .step-branch {
    display: none;
  }

  /* The heading receives focus when the step changes, so that a screen reader
     reads it. It is a focus target, not a control: no ring. */
  .step-title:focus {
    outline: none;
  }
</style>

<style is:global>
  /* Defaults for what authors write inside a step: plain Markdown and a plain
     text field. Zero specificity (:where), so a question component overrides
     them with a single class. */
  :where([data-step]) :where(p, ul, ol, blockquote) {
    max-width: 65ch;
  }

  :where([data-step]) :where(ul, ol) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  :where([data-step]) :where(li + li) {
    margin-top: var(--space-1);
  }

  :where([data-step]) :where(textarea) {
    display: block;
    width: 100%;
    max-width: 65ch;
    margin-top: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    color: var(--ink);
    font: inherit;
    resize: vertical;
  }

  :where([data-step]) :where(textarea)::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }
</style>
