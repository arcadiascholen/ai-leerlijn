---
// One module in the overview (src/pages/modules/index.astro), built from its
// frontmatter (docs/BRIEFING.md § 5): title, `kort`, grades and whether the
// student uses AI. `niveau` and `duur` stay internal and are not shown:
// students choose on interest and grade, not on the least effort. A module
// that is ready links to its page; one with `status: binnenkort` is dimmed,
// has no link and says "Binnenkort".
import type { CollectionEntry } from 'astro:content';
import AiGebruik from './AiGebruik.astro';
import { gradesLabel } from './labels';

interface Props {
  entry: CollectionEntry<'modules'>;
}

const { entry } = Astro.props;
const { title, kort, graden, aiGebruik, status } = entry.data;
const available = status === 'beschikbaar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/modules/${entry.id}/`;
---

<article class:list={['card', { 'card--soon': !available }]}>
  {/* The heading comes first for screen readers; the grades line is moved
      above it with `order`. */}
  <h2 class="card-title">
    {available ? <a href={href}>{title}</a> : title}
  </h2>
  <p class="card-top">
    <span>{gradesLabel(graden)}</span>
    {!available && <span class="card-soon">Binnenkort</span>}
  </p>
  <p class="card-kort">{kort}</p>
  <div class="card-foot">
    <AiGebruik value={aiGebruik} />
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    order: -1;
    margin: 0 0 var(--space-2);
    color: var(--brand-text);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    font-weight: var(--text-label-weight);
    letter-spacing: var(--text-label-tracking);
    text-transform: uppercase;
  }

  /* A badge on the top border: it takes no height, so a long grades line
     and the badge never wrap onto two lines. */
  .card-soon {
    position: absolute;
    top: 0;
    right: var(--space-4);
    transform: translateY(-50%);
    padding: 2px var(--space-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--ink-muted);
  }

  .card-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line);
    font-weight: var(--text-h3-weight);
    letter-spacing: var(--text-h3-tracking);
  }

  .card-title a {
    color: var(--forest);
    text-decoration: none;
  }

  /* The whole card is the link: the title's link stretches over it. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .card:has(a):hover {
    border-color: var(--brand);
  }

  .card:has(a):hover .card-title a {
    text-decoration: underline;
  }

  /* Hover only (docs/DESIGN.md, "Beweging"). */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition: border-color var(--motion-fast) var(--ease-out);
    }
  }

  .card-kort {
    max-width: none;
    margin: 0;
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    font-weight: var(--text-small-weight);
    letter-spacing: var(--text-small-tracking);
  }

  /* Pushed to the bottom, so the AI sentence lines up across a row. */
  .card-foot {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  /* Not ready yet: dimmed, without lowering text contrast below 4.5:1. */
  .card--soon {
    border-style: dashed;
    border-color: var(--line-strong);
    background: var(--surface-sunken);
    color: var(--ink-muted);
  }

  .card--soon .card-title,
  .card--soon .card-top {
    color: var(--ink-muted);
  }

  .card--soon :global(.ai-use) {
    color: var(--ink-muted);
  }
</style>
