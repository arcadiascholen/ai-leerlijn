---
// One module in the overview (src/pages/modules/index.astro), built from its
// frontmatter (docs/BRIEFING.md § 5): title, `kort`, grades, level in stars,
// duration, and whether the student uses AI. A module that is ready links to
// its page; one with `status: binnenkort` is dimmed, has no link and says
// "Binnenkort".
import type { CollectionEntry } from 'astro:content';
import AiGebruik from './AiGebruik.astro';
import { gradesLabel, MAX_LEVEL } from './labels';

interface Props {
  entry: CollectionEntry<'modules'>;
}

const { entry } = Astro.props;
const { title, kort, graden, niveau, duur, aiGebruik, status } = entry.data;
const available = status === 'beschikbaar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/modules/${entry.id}/`;
const stars = Array.from({ length: MAX_LEVEL }, (_, index) => index < niveau);
---

<article class:list={['card', { 'card--soon': !available }]}>
  {/* The heading comes first for screen readers; the grades line is moved
      above it with `order`. */}
  <h2 class="card-title">
    {available ? <a href={href}>{title}</a> : title}
  </h2>
  <p class="card-top">
    <span>{gradesLabel(graden)}</span>
    {!available && <span class="card-soon">Binnenkort</span>}
  </p>
  <p class="card-kort">{kort}</p>
  <div class="card-foot">
    <p class="card-meta">
      <span class="card-level">
        Niveau
        <span class="card-stars" aria-hidden="true">
          {stars.map((filled) => (
            <svg viewBox="0 0 24 24" class:list={{ filled }}>
              <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
            </svg>
          ))}
        </span>
        <span class="sr-only">{niveau} van {MAX_LEVEL}</span>
      </span>
      <span class="card-duration">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
        {duur} min
      </span>
    </p>
    <AiGebruik value={aiGebruik} />
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    order: -1;
    margin: 0 0 var(--space-2);
    color: var(--brand-text);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    font-weight: var(--text-label-weight);
    letter-spacing: var(--text-label-tracking);
    text-transform: uppercase;
  }

  /* A badge on the top border: it takes no height, so a long grades line
     and the badge never wrap onto two lines. */
  .card-soon {
    position: absolute;
    top: 0;
    right: var(--space-4);
    transform: translateY(-50%);
    padding: 2px var(--space-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--ink-muted);
  }

  .card-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line);
    font-weight: var(--text-h3-weight);
    letter-spacing: var(--text-h3-tracking);
  }

  .card-title a {
    color: var(--forest);
    text-decoration: none;
  }

  /* The whole card is the link: the title's link stretches over it. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .card:has(a):hover {
    border-color: var(--brand);
  }

  .card:has(a):hover .card-title a {
    text-decoration: underline;
  }

  /* Hover only (docs/DESIGN.md, "Beweging"). */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition: border-color var(--motion-fast) var(--ease-out);
    }
  }

  .card-kort {
    max-width: none;
    margin: 0;
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    font-weight: var(--text-small-weight);
    letter-spacing: var(--text-small-tracking);
  }

  .card-foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    font-weight: var(--text-small-weight);
    letter-spacing: var(--text-small-tracking);
  }

  .card-level,
  .card-duration {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .card-stars {
    display: inline-flex;
    gap: 1px;
  }

  .card-meta svg {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card-stars svg {
    stroke: var(--line-strong);
  }

  .card-stars svg.filled {
    fill: var(--brand-text);
    stroke: var(--brand-text);
  }

  /* Not ready yet: dimmed, without lowering text contrast below 4.5:1. */
  .card--soon {
    border-style: dashed;
    border-color: var(--line-strong);
    background: var(--surface-sunken);
    color: var(--ink-muted);
  }

  .card--soon .card-title,
  .card--soon .card-top {
    color: var(--ink-muted);
  }

  .card--soon .card-stars svg.filled {
    fill: var(--ink-muted);
    stroke: var(--ink-muted);
  }

  .card--soon :global(.ai-use) {
    color: var(--ink-muted);
  }
</style>
